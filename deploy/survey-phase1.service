[Unit]
Description=Survey Phase 1 web application
After=network-online.target mongod.service
Requires=mongod.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/survey-phase1
EnvironmentFile=/opt/survey-phase1/.env
ExecStart=/opt/survey-phase1/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8767 --timeout 120 run:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
